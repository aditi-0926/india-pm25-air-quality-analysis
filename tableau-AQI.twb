      <column caption='Season' datatype='string' name='[Calculation_0578125794140160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([period_start]) = 12&#13;&#10;OR MONTH([period_start]) = 1&#13;&#10;OR MONTH([period_start]) = 2 THEN &quot;Winter&quot;&#13;&#10;&#13;&#10;ELSEIF MONTH([period_start]) &gt;= 3&#13;&#10;AND MONTH([period_start]) &lt;= 5 THEN &quot;Pre-Monsoon&quot;&#13;&#10;&#13;&#10;ELSEIF MONTH([period_start]) &gt;= 6&#13;&#10;AND MONTH([period_start]) &lt;= 9 THEN &quot;Monsoon&quot;&#13;&#10;&#13;&#10;ELSE &quot;Post-Monsoon&quot;&#13;&#10;END' />
      </column>
